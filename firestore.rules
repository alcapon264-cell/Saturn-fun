rules_version = '2';
// Clients may READ only their own account document and can never write anything.
// Every write (accounts, wallet links, events, errors) is done by the backend with the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
