rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read only their own account.
    match /users/{uid} {
      allow read: if request.auth != null
                  && request.auth.uid == uid;
      allow write: if false;
    }

    // Saturn Social: public single-message reads;
// list queries must be limited to 100 messages.
match /communityRooms/{room}/messages/{msg} {
  allow get: if true;
  allow list: if request.query.limit != null
              && request.query.limit <= 100;
  allow write: if false;
}

    // Community rate-limit and identity records stay private.
    match /communityUsers/{uid} {
      allow read, write: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
